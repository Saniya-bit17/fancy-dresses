# Maison Solène Haute Couture API Environment Variables
PORT=5000
NODE_ENV=production

# Frontend URL(s), comma-separated if multiple (e.g., your Vercel domain)
CLIENT_ORIGIN=https://maison-solene.vercel.app

# MongoDB Atlas Connection String
# IMPORTANT: In MongoDB Atlas Network Access, add 0.0.0.0/0 to allow connections from Render's cloud servers
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/maison_solene?retryWrites=true&w=majority
DB_NAME=maison_solene
